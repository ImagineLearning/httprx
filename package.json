{
	"name": "@imaginelearning/httprx",
	"author": "Imagine Learning",
	"version": "0.1.7",
	"license": "MIT",
	"main": "dist/index.js",
	"module": "dist/httprx.esm.js",
	"typings": "dist/index.d.ts",
	"files": [
		"dist",
		"src"
	],
	"engines": {
		"node": ">=10"
	},
	"scripts": {
		"start": "tsdx watch",
		"build": "tsdx build",
		"test": "tsdx test --watch",
		"test:ci": "cross-env CI=true tsdx test --coverage",
		"lint": "eslint \"src/**/*.{js,ts}\"",
		"format": "prettier --config .prettierrc --write \"**/*.{js,json,ts}\"",
		"prepack": "tsdx build"
	},
	"dependencies": {},
	"peerDependencies": {
		"rxjs": "^6.6.0"
	},
	"devDependencies": {
		"cross-env": "^7.0.2",
		"husky": "^4.2.5",
		"jest": "^26.1.0",
		"jest-fetch-mock": "^3.0.3",
		"jest-teamcity-reporter": "^0.9.0",
		"lint-staged": "^10.2.11",
		"node-fetch": "^2.6.7",
		"prettier": "^2.0.5",
		"pretty-quick": "^2.0.1",
		"tsdx": "^0.13.2",
		"tslib": "^2.0.0",
		"typescript": "^3.9.7"
	},
	"resolutions": {
		"minimist": "1.2.8",
		"@babel/traverse": "^7.23.2",
		"form-data": "2.5.6",
		"y18n": "4.0.1",
		"lodash": "4.18.1",
		"tmpl": "1.0.5",
		"shelljs": "0.8.5",
		"node-fetch": "2.6.7",
		"terser": "4.8.1",
		"minimatch": "3.1.5",
		"decode-uri-component": "0.2.2",
		"qs": "6.17.1",
		"glob-parent": "5.1.2",
		"brace-expansion": "1.1.22",
		"js-yaml": "3.15.2",
		"browserslist": "4.28.7",
		"hosted-git-info": "2.8.9",
		"path-parse": "1.0.7",
		"word-wrap": "1.2.4",
		"picomatch": "2.3.2",
		"@babel/core": "7.29.6",
		"**/tsconfig-paths/json5": "1.0.2",
		"**/ts-jest/json5": "2.2.3",
		"**/@babel/core/json5": "2.2.3",
		"**/core-js-compat/semver": "7.5.2",
		"**/@typescript-eslint/typescript-estree/debug": "4.3.1",
		"**/eslint/debug": "4.3.1",
		"**/istanbul-lib-source-maps/debug": "4.3.1",
		"**/lint-staged/debug": "4.3.1",
		"**/@babel/core/debug": "4.3.1"
	},
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged -p false"
		}
	},
	"prettier": {
		"printWidth": 80,
		"semi": true,
		"singleQuote": true,
		"trailingComma": "es5"
	},
	"lint-staged": {
		"*.(js|json|ts)": "pretty-quick --staged --config .prettierrc",
		"*.(js|ts)": "yarn lint"
	}
}
